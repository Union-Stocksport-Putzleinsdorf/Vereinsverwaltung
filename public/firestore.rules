rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Die App nutzt nur die Collection "appData" und kein Firebase Auth.
    // Daher muss Lesen/Schreiben offen bleiben, sonst funktioniert die App nicht.
    match /appData/{doc} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
